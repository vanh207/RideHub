# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=KS25 Base API

# ---- MySQL ----
# Điền giống thông tin bạn dùng để kết nối trong MySQL Workbench
# (Workbench: chuột phải vào connection -> Edit Connection để xem Hostname/Port/Username).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Mật khẩu root bạn đặt lúc cài MySQL (XAMPP mặc định để trống)
DB_PASSWORD=123456
DB_NAME=app_db

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# ---- Cổng thanh toán Sandbox (Mock Payment Gateway - TF19E3D) ----
PAYMENT_GATEWAY_SECRET=ridehub_mock_secret_key_2026_tf19e3d
PAYMENT_MOCK_BASE_URL=https://sandbox.ridehub.vn

# ---- Cổng thanh toán PayOS (Thanh toán tiền cọc - TF19EFA) ----
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# ---- Cấu hình Email (SMTP hoặc Mock) ----
EMAIL_BACKEND=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM_EMAIL=no-reply@ridehub.vn
SMTP_FROM_NAME=RideHub
