# ==============================================================================
# RIDEHUB CONFIGURATION & API KEYS (SAMPLE FILE)
# ==============================================================================
# Copy file này thành .env rồi điền thông tin phù hợp với môi trường của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên Git.

APP_NAME=RideHub API

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_db

# ---- CORS ----
CORS_ORIGINS=*

# ---- JWT Authentication ----
JWT_SECRET_KEY=your_strong_random_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Firebase Admin SDK & Web API Key ----
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_WEB_API_KEY=AIzaSyAeC9Ln5LN9IIlHhuwGoAcwKYp-8HDDyKU
FIREBASE_PROJECT_ID=ridehub-carmoto
FIREBASE_AUTH_DOMAIN=ridehub-carmoto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ridehub-carmoto.appspot.com

# ---- Đặt xe & giữ chỗ (TF197DE) ----
BOOKING_HOLD_MINUTES=30
BOOKING_BUFFER_MINUTES=60
BOOKING_MIN_DURATION_HOURS=4
BOOKING_MAX_DURATION_DAYS=30
BOOKING_DEPOSIT_RATE=0.30
BOOKING_DEPOSIT_MIN=200000
BOOKING_DEPOSIT_MAX=1000000
BOOKING_MIN_START_LEAD_MINUTES=0
BOOKING_HOURLY_MAX_HOURS=24
BOOKING_LOCK_RETRY_ATTEMPTS=3
BOOKING_LOCK_RETRY_BASE_DELAY_SECONDS=0.05

# ---- Hủy đơn & hoàn tiền ----
BOOKING_CANCEL_FREE_HOURS=24
BOOKING_CANCEL_PARTIAL_HOURS=6
BOOKING_CANCEL_PARTIAL_RATE=0.5
BOOKING_CANCEL_STORE_FAULT_RATE=1.0

# ---- Job tự hủy đơn hết hạn giữ chỗ ----
BOOKING_EXPIRY_JOB_ENABLED=true
BOOKING_EXPIRY_JOB_INTERVAL_SECONDS=60
BOOKING_EXPIRY_JOB_BATCH_SIZE=100

# ---- Cổng thanh toán Sandbox (Mock Payment Gateway - TF19E3D) ----
PAYMENT_GATEWAY_SECRET=your_mock_webhook_secret_here
PAYMENT_MOCK_BASE_URL=https://sandbox.ridehub.vn

# ---- Cổng thanh toán PayOS (Thanh toán tiền cọc - TF19EFA) ----
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here
PAYOS_RETURN_URL=http://127.0.0.1:8000/frontend/payment-result.html
PAYOS_CANCEL_URL=http://127.0.0.1:8000/frontend/payment-result.html
# Optional fallback only when PayOS does not return beneficiary details.
PAYOS_BANK_NAME=
PAYOS_ACCOUNT_NUMBER=
PAYOS_ACCOUNT_NAME=

# ---- Cấu hình Email (SMTP hoặc Mock) ----
EMAIL_BACKEND=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM_EMAIL=no-reply@ridehub.vn
SMTP_FROM_NAME=RideHub Notification

# ---- Cấu hình Chatbot AI (API Key) ----
# Chọn: auto (tự dùng key nào đã điền), gemini, openai, hoặc mock
AI_PROVIDER=auto
GEMINI_API_KEY=your_google_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Để trống sẽ tự dùng gemini-2.5-flash (Gemini) hoặc gpt-4o-mini (OpenAI)
AI_MODEL_NAME=

# ---- eKYC / xác thực danh tính (TASK_BONUS_FACECHECK) ----
# Bật luồng eKYC. KYC_REQUIRED_FOR_BOOKING mặc định false để giữ luồng đặt xe cũ.
KYC_ENABLED=true
KYC_REQUIRED_FOR_BOOKING=false
# manual | mock | vendor. manual là mặc định: không tự chấm điểm, admin duyệt.
KYC_FACE_PROVIDER=manual
# Điểm cố định cho MockProvider (test/demo), chưa hiệu chỉnh.
KYC_MOCK_SCORE=0.82
# Để trống vì chưa có dữ liệu hiệu chỉnh; không tự gán ngưỡng.
KYC_MATCH_THRESHOLD=
# Chỉ cần điền khi KYC_FACE_PROVIDER=vendor; thiếu thì ứng dụng báo lỗi rõ khi khởi động.
KYC_VENDOR_BASE_URL=
KYC_VENDOR_API_KEY=
KYC_VENDOR_TIMEOUT_SECONDS=10

KYC_CONSENT_VERSION=2026-11-v1
# Cần thay bằng thông tin thật trước khi đưa vào sản phẩm.
KYC_PRIVACY_CONTACT_EMAIL=[ĐIỀN email nhóm]
KYC_LEGAL_REVIEWER=[ĐIỀN tên nhóm trưởng/giảng viên]

KYC_SESSION_TTL_MINUTES=15
KYC_DAILY_ATTEMPT_LIMIT=5
KYC_MAX_UPLOAD_BYTES=5242880
KYC_MIN_IMAGE_WIDTH=640
KYC_MIN_IMAGE_HEIGHT=480
KYC_MAX_IMAGE_PIXELS=20000000
# Tỷ lệ khung là giá trị khởi tạo, chưa hiệu chỉnh với thẻ thật.
KYC_ID_ASPECT_MIN=1.20
KYC_ID_ASPECT_MAX=2.00
KYC_SELFIE_ASPECT_MIN=0.50
KYC_SELFIE_ASPECT_MAX=2.00
KYC_BLUR_CHECK_ENABLED=true
KYC_QR_CHECK_ENABLED=true

# Chỉ có hiệu lực sau khi tài liệu pháp lý được xác nhận.
KYC_FACE_RETENTION_DAYS=30
KYC_ID_RETENTION_DAYS=180
KYC_PRIVATE_UPLOAD_DIR=private_uploads/kyc
KYC_CLEANUP_JOB_ENABLED=true
KYC_CLEANUP_JOB_INTERVAL_SECONDS=3600
KYC_CLEANUP_BATCH_SIZE=100
