# ==============================================================================
# RIDEHUB CONFIGURATION & API KEYS (SAMPLE FILE)
# ==============================================================================
# Copy file này thành .env rồi điền thông tin phù hợp với môi trường của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên Git.

APP_NAME=RideHub API

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_db

# ---- CORS ----
CORS_ORIGINS=*

# ---- JWT Authentication ----
JWT_SECRET_KEY=your_strong_random_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Firebase Admin SDK & Web API Key ----
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_WEB_API_KEY=AIzaSyAeC9Ln5LN9IIlHhuwGoAcwKYp-8HDDyKU
FIREBASE_PROJECT_ID=ridehub-carmoto
FIREBASE_AUTH_DOMAIN=ridehub-carmoto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ridehub-carmoto.appspot.com

# ---- Đặt xe & giữ chỗ (TF197DE) ----
BOOKING_HOLD_MINUTES=30
BOOKING_BUFFER_MINUTES=60
BOOKING_MIN_DURATION_HOURS=4
BOOKING_MAX_DURATION_DAYS=30
BOOKING_DEPOSIT_RATE=0.30
BOOKING_DEPOSIT_MIN=200000
BOOKING_DEPOSIT_MAX=1000000
BOOKING_MIN_START_LEAD_MINUTES=0
BOOKING_HOURLY_MAX_HOURS=24
BOOKING_LOCK_RETRY_ATTEMPTS=3
BOOKING_LOCK_RETRY_BASE_DELAY_SECONDS=0.05

# ---- Hủy đơn & hoàn tiền ----
BOOKING_CANCEL_FREE_HOURS=24
BOOKING_CANCEL_PARTIAL_HOURS=6
BOOKING_CANCEL_PARTIAL_RATE=0.5
BOOKING_CANCEL_STORE_FAULT_RATE=1.0

# ---- Job tự hủy đơn hết hạn giữ chỗ ----
BOOKING_EXPIRY_JOB_ENABLED=true
BOOKING_EXPIRY_JOB_INTERVAL_SECONDS=60
BOOKING_EXPIRY_JOB_BATCH_SIZE=100

# ---- Cổng thanh toán Sandbox (Mock Payment Gateway - TF19E3D) ----
PAYMENT_GATEWAY_SECRET=your_mock_webhook_secret_here
PAYMENT_MOCK_BASE_URL=https://sandbox.ridehub.vn

# ---- Cổng thanh toán PayOS (Thanh toán tiền cọc - TF19EFA) ----
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here
PAYOS_RETURN_URL=http://127.0.0.1:8000/frontend/payment-result.html
PAYOS_CANCEL_URL=http://127.0.0.1:8000/frontend/payment-result.html
# Optional fallback only when PayOS does not return beneficiary details.
PAYOS_BANK_NAME=
PAYOS_ACCOUNT_NUMBER=
PAYOS_ACCOUNT_NAME=

# ---- Cấu hình Email (SMTP hoặc Mock) ----
EMAIL_BACKEND=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM_EMAIL=no-reply@ridehub.vn
SMTP_FROM_NAME=RideHub Notification
